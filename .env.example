# Public Supabase project values. Leave unset to run the read-only demonstration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Required for authorized moderation and account-deletion operations.
SUPABASE_SERVICE_ROLE_KEY=

# Optional absolute origin used in authentication email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
