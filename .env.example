# Public Supabase project values. Both are required on a production origin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Fixture data is available only on explicitly labelled demo routes. Keep this
# false in production; a production origin refuses to start when it is true.
NEXT_PUBLIC_DEMO_MODE=true

# Server only. Required for authorized moderation and account-deletion operations.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute application origin used for email and social OAuth callbacks.
# Production: https://farmerbook.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional comma-separated Cloudflare custom domains, configured by deployment.
# Example: farmerbook.in,www.farmerbook.in
FARMERBOOK_CUSTOM_DOMAINS=

# Additive ecosystem releases remain disabled until their migration and test
# gates are complete in the target environment.
ENABLE_CANONICAL_AGRICULTURE_TAXONOMY=false
ENABLE_RESUMABLE_ONBOARDING=false
ENABLE_AGRI_BUSINESSES=false
ENABLE_BUSINESS_OFFERS=false
ENABLE_EXTENDED_LOCALES=false
ENABLE_INC_SOURCING=false
ENABLE_OUTREACH_AGENT=false
ENABLE_PROFILE_RESEARCH_AGENT=false
ENABLE_MANAGED_OPERATIONS_AGENTS=false

# Name-only profile discovery. Store the API key with `wrangler secret put`,
# never in a committed environment file. Confirm storage rights only when the
# selected Brave Search API plan explicitly permits the retained snippets.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_STORAGE_RIGHTS_CONFIRMED=false

# Known Farmer Intake YouTube discovery. Enable the YouTube Data API in the
# approved Google Cloud project and install this only with `wrangler secret put`.
# Never expose the key through NEXT_PUBLIC_* variables or commit a real value.
YOUTUBE_DATA_API_KEY=

# Consent-first acquisition. The public key may be exposed in the browser; the
# remaining values are server-only secrets and must use the deployment secret store.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_LEAD_WEBHOOK_SECRET=
OUTREACH_PROVIDER_BASE_URL=
OUTREACH_PROVIDER_API_TOKEN=
OUTREACH_PROVIDER_WEBHOOK_SECRET=
# Concrete email provider. Enable only after the domain, Broadcast Message
# Stream, inbound address and authenticated webhooks are verified.
OUTREACH_PROVIDER_KIND=
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_INBOUND_ADDRESS=
POSTMARK_MESSAGE_STREAM=
POSTMARK_WEBHOOK_USERNAME=
POSTMARK_WEBHOOK_PASSWORD=
OUTREACH_EMAIL_ACTION_SIGNING_SECRET=
OUTREACH_CONSENT_SIGNING_SECRET=
OUTREACH_INVITATION_SIGNING_SECRET=
OUTREACH_PROCESSOR_SECRET=

# Internal bearer used only by the private scheduled Durable Object fleet.
# Generate at least 32 random bytes and store it with `wrangler secret put`.
MANAGED_AGENT_PROCESSOR_SECRET=
